{
  "name": "ebrar-islami-website",
  "private": true,
  "description": "Ebrar Islami - Personal Website",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ./src",
    "prettier:check": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "format": "prettier . --write",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@heroicons/react": "2.2.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sharp": "0.35.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.2.11",
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.7.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "postcss": "8.5.22",
    "prettier": "3.9.6",
    "sass": "1.101.7",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "packageManager": "pnpm@11.17.0",
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "engines": {
    "node": "24.x"
  }
