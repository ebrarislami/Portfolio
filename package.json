    "react-icons": "5.7.0",
    "sharp": "0.35.4",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@svgr/webpack": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxlint": "1.80.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "packageManager": "pnpm@11.24.0",
